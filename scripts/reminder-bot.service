[Unit]
Description=Telegram Reminder Bot
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=reminder_bot
Group=reminder_bot
WorkingDirectory=/opt/reminder_bot
Environment="PYTHONPATH=/opt/reminder_bot"
Environment="PATH=/opt/reminder_bot/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStartPre=/opt/reminder_bot/venv/bin/python /opt/reminder_bot/setup_db.py
ExecStart=/opt/reminder_bot/venv/bin/python -m src.bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reminder-bot

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/reminder_bot

[Install]
WantedBy=multi-user.target