# Deploy Configuration for Reminder Telegram Bot
# ===============================================
# Copy this file to deploy.conf and update with your server details

# Server Configuration
SERVER_IP="your.server.ip.address"
SERVER_USER="your_deploy_user"
SERVER_SSH_KEY="$HOME/.ssh/your_deploy_key"

# Deployment Paths
REMOTE_DIR="/opt/reminder_tg_bot"

# Service Configuration
SERVICE_NAME="reminder-bot"