#!/bin/bash

# Simple deployment script for Reminder Telegram Bot
# ===================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
CONFIG_FILE="$SCRIPT_DIR/deploy.conf"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }

# Load config
if [ ! -f "$CONFIG_FILE" ]; then
    log_error "Config file not found: $CONFIG_FILE"
    echo ""
    echo "Create the config file by copying the sample:"
    echo "  cp $SCRIPT_DIR/deploy.conf.sample $CONFIG_FILE"
    echo ""
    echo "Then edit it with your server details:"
    echo "  nano $CONFIG_FILE"
    exit 1
fi
source "$CONFIG_FILE"

# Parse options
RESTART_ONLY=false
if [[ "${1:-}" == "--restart-only" ]]; then
    RESTART_ONLY=true
fi

echo "🚀 Deploying Reminder Bot"
echo "=========================="

# Test SSH connection first
log_info "Testing SSH connection..."
if ! ssh -i "$SERVER_SSH_KEY" -o ConnectTimeout=10 "$SERVER_USER@$SERVER_IP" "echo 'SSH connection successful'"; then
    log_error "SSH connection failed. Please check:"
    log_error "  1. SSH key exists: $SERVER_SSH_KEY"
    log_error "  2. SSH key has correct permissions (600)"
    log_error "  3. Public key is added to server: $SERVER_USER@$SERVER_IP"
    log_error ""
    log_error "To fix SSH key permissions: chmod 600 $SERVER_SSH_KEY"
    log_error "To add public key to server, run on server:"
    log_error "  mkdir -p ~/.ssh && echo 'YOUR_PUBLIC_KEY' >> ~/.ssh/authorized_keys"
    exit 1
fi

if [ "$RESTART_ONLY" = false ]; then
    # Push latest code to server
    log_info "Pushing latest code to server..."
    ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && git pull origin master"
    
    # Install/update dependencies on server
    log_info "Installing dependencies on server..."
    ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && python3 -m pip install -r requirements.txt" || \
    ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && pip3 install -r requirements.txt" || \
    ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && pip install -r requirements.txt" || {
        log_error "Failed to install dependencies. Python pip not found."
        echo ""
        echo "Please install pip on the server first:"
        echo "  ssh -i $SERVER_SSH_KEY $SERVER_USER@$SERVER_IP"
        echo "  sudo apt update && sudo apt install python3-pip"
        echo "  # or"
        echo "  curl https://bootstrap.pypa.io/get-pip.py -o get-pip.py"
        echo "  python3 get-pip.py --user"
        exit 1
    }
    
    # Run database migrations if needed
    log_info "Running database migrations..."
    ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && python3 -m alembic upgrade head" || \
    ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && python -m alembic upgrade head" || \
    log_warning "Migration failed or no migrations needed"
    
    log_success "Code deployment completed"
fi

# Check sudo permissions
log_info "Checking sudo permissions..."
if ! ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "sudo -n systemctl is-active $SERVICE_NAME >/dev/null 2>&1"; then
    log_error "Passwordless sudo not configured for systemctl commands"
    echo ""
    echo "To fix this, ask your system administrator to add this line to /etc/sudoers:"
    echo "  $SERVER_USER ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart $SERVICE_NAME, /usr/bin/systemctl status $SERVICE_NAME, /usr/bin/systemctl is-active $SERVICE_NAME, /usr/bin/journalctl"
    echo ""
    echo "Or for all systemctl commands:"
    echo "  $SERVER_USER ALL=(ALL) NOPASSWD: /usr/bin/systemctl"
    echo ""
    echo "Alternatively, you can manually restart the service on the server:"
    echo "  ssh -i $SERVER_SSH_KEY $SERVER_USER@$SERVER_IP"
    echo "  sudo systemctl restart $SERVICE_NAME"
    exit 1
fi

# Restart service
log_info "Restarting service..."
ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "sudo systemctl restart $SERVICE_NAME"
sleep 3

# Check status
log_info "Checking service status..."
if ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "sudo systemctl is-active $SERVICE_NAME --quiet"; then
    log_success "Service is running"
else
    log_error "Service is not active"
    ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "sudo systemctl status $SERVICE_NAME --no-pager --lines=10" || true
fi

# Show recent logs
log_info "Recent logs:"
ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "sudo journalctl -u $SERVICE_NAME --no-pager -n 15" 2>/dev/null || \
ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "tail -n 15 $REMOTE_DIR/bot.log 2>/dev/null || echo 'No logs found'"

log_success "Deployment completed!"

echo ""
echo "📋 Useful commands:"
echo "  View logs:   ssh -i $SERVER_SSH_KEY $SERVER_USER@$SERVER_IP 'sudo journalctl -u $SERVICE_NAME -f'"
echo "  Restart:     $0 --restart-only"
echo "  SSH access:  ssh -i $SERVER_SSH_KEY $SERVER_USER@$SERVER_IP"
echo "  Service:     ssh -i $SERVER_SSH_KEY $SERVER_USER@$SERVER_IP 'sudo systemctl status $SERVICE_NAME'"