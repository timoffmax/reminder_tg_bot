BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=postgresql://username:password@localhost:5432/reminder_bot
DEFAULT_TIMEZONE=UTC

# Example for local PostgreSQL (adjust username/password as needed):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reminder_bot

# Example for Docker PostgreSQL on different port:
# DATABASE_URL=postgresql://reminder_user:reminder_pass@localhost:5433/reminder_bot