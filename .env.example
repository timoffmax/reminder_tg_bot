# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/reminder_bot

# Default timezone for new users (optional, defaults to UTC)
DEFAULT_TIMEZONE=UTC

# Only needed for docker-compose.standalone.yml (bundled PostgreSQL container).
# It is embedded in a connection URL, so keep it URL-safe (letters and digits).
# POSTGRES_PASSWORD=choose_a_strong_password
