# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Database Configuration
# Choose one of the following database configurations:

# Option 1: SQLite (default, simple setup)
DATABASE_URL=sqlite:///reminder_bot.db

# Option 2: PostgreSQL (production recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/reminder_bot
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=reminder_bot
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# Option 3: MySQL/MariaDB
# DATABASE_URL=mysql://user:password@localhost:3306/reminder_bot
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=reminder_bot
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Application Settings
TIMEZONE=UTC
MAX_REMINDERS_PER_USER=100
REMINDER_CHECK_INTERVAL=60

# Security Settings (optional)
# WEBHOOK_URL=https://yourdomain.com/webhook
# WEBHOOK_SECRET=your_webhook_secret

# Development Settings
DEBUG=False
DEVELOPMENT_MODE=False